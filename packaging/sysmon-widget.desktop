[Desktop Entry]
Type=Application
Name=Sysmon Widget
GenericName=Desktop System Monitor
Comment=Conky-style desktop widget: clock, weather, system stats, music
Exec=/usr/bin/sysmon-widget
Icon=utilities-system-monitor
Path=/opt/sysmon-widget
Terminal=false
StartupNotify=false
Categories=Utility;System;Monitor;
Keywords=sysmon;monitor;widget;conky;tray;
X-GNOME-Autostart-enabled=true
